# Optional. Enables privacy-safe Google Analytics 4 event tracking.
# Leave blank for local demos or if GA4 is not approved/configured.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional. Backend-only GA4 import connector for historical story performance.
# Property ID is not secret. Credentials must stay backend-only.
GA4_PROPERTY_ID=315631542
GOOGLE_APPLICATION_CREDENTIALS=
GA4_SERVICE_ACCOUNT_JSON=
GA4_ACCESS_TOKEN=
GA4_IMPORT_LIMIT=10000
VITE_GA4_IMPORT_ENDPOINT=http://127.0.0.1:8787/api/ga4/import

# Optional. Server endpoint for model-backed draft review.
# Keep provider API keys on the server, never in the browser.
VITE_AI_REVIEW_ENDPOINT=

# Optional. Backend-only OpenAI draft review connector.
# Never prefix this key with VITE_ because that would expose it in the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_REVIEW_PORT=8787
AI_REVIEW_ALLOWED_ORIGIN=http://127.0.0.1:5173
AI_REVIEW_MAX_DRAFT_CHARS=16000
AI_REVIEW_TIMEOUT_MS=60000
VITE_AI_REVIEW_ENDPOINT=http://127.0.0.1:8787/api/review-draft
